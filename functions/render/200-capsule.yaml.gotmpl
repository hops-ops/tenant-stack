# code: language=yaml
#
# Helm Release: capsule
#
# Chart:    https://projectcapsule.github.io/charts (chart name: capsule)
# Upstream: https://github.com/projectcapsule/capsule
#
# Pinned default: chart 0.12.4 / app v0.12.4 — the spec minimum (≥ v0.12.x for
# the webhook refactor that closed the CVE-2024-39690 / CVE-2025-55205 namespace
# label injection CVE class). Override via spec.capsule.chartVersion.
#
# First-pass scope: install the controller only.
#   - `proxy.enabled: false` — the upstream chart bundles `capsule-proxy` as an
#     optional dependency; we keep it off here. Proxy install lands in its own
#     iteration once Zitadel OIDC wiring is in place.
#   - `serviceMonitor.enabled: false` — ObserveStack integration is a separate
#     iteration.
#   - Default RBAC + Kyverno hardening for the Capsule CVE class is tracked in
#     tasks/tenant-stack-cve-hardening (not part of this stack yet).
#
# wait: true — Capsule's controller is a small Deployment that reaches Ready
# quickly. We want a stable Ready signal so downstream Tenant XRs (future) can
# gate on observed CRD Established status per the composition-internal gating
# convention (feedback_crossplane_composition_gates).
#

{{- $cp := $state.capsule }}
{{- if $cp.enabled }}
{{- $chartDefaults := dict
  "proxy" (dict "enabled" false)
  "serviceMonitor" (dict "enabled" false)
  "manager" (dict
    "resources" (dict
      "requests" (dict "cpu" "23m" "memory" "283Mi")
      "limits" (dict "cpu" "100m" "memory" "768Mi")
    )
    "livenessProbe" (dict "timeoutSeconds" 5)
    "readinessProbe" (dict "timeoutSeconds" 5)
  )
}}
{{- $mergedValues := mergeOverwrite $chartDefaults ($cp.values | default dict) }}
---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $cp.releaseName }}
  annotations:
    {{ setResourceNameAnnotation "capsule" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: capsule
      repository: https://projectcapsule.github.io/charts
      version: {{ $cp.chartVersion | quote }}
    namespace: {{ $cp.namespace }}
    wait: true
    {{- if gt (len $cp.overrideAllValues) 0 }}
    values:
      {{- toYaml $cp.overrideAllValues | nindent 6 }}
    {{- else }}
    values:
      {{- toYaml $mergedValues | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helmProviderConfigRef.name }}
    kind: {{ $state.helmProviderConfigRef.kind }}
{{- end }}

# code: language=yaml
#
# Initialize $state with spec defaults
#

{{- $xr := getCompositeResource . }}
{{- $spec := $xr.spec | default dict }}
{{- $metadata := $xr.metadata | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "tenant" }}
{{- $namespace := $metadata.namespace | default "default" }}
{{- $clusterName := $spec.clusterName | default $name }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}

# Labels — every composed resource carries hops.ops.com.ai/managed=true and a
# kind-scoped marker. User-provided labels merge on top.
{{- $kindKey := printf "hops.ops.com.ai/%s" (lower $xr.kind) }}
{{- $defaultLabels := dict
  "hops.ops.com.ai/managed" "true"
  $kindKey $name
}}
{{- $labels := mergeOverwrite (dict) $defaultLabels ($spec.labels | default dict) }}

# ==============================================================================
# Provider config refs (both default to clusterName)
# ==============================================================================
{{- $helmPCR := $spec.helmProviderConfigRef | default dict }}
{{- $helmPCR = dict
  "name" ($helmPCR.name | default $clusterName)
  "kind" ($helmPCR.kind | default "ProviderConfig")
}}

{{- $k8sPCR := $spec.kubernetesProviderConfigRef | default dict }}
{{- $k8sPCR = dict
  "name" ($k8sPCR.name | default $clusterName)
  "kind" ($k8sPCR.kind | default "ProviderConfig")
}}

# ==============================================================================
# Capsule controller component
# ==============================================================================
{{- $cp := $spec.capsule | default dict }}
{{- $cpEnabled := true }}
{{- if hasKey $cp "enabled" }}
  {{- $cpEnabled = $cp.enabled }}
{{- end }}
{{- $cpNamespace := $cp.namespace | default "capsule-system" }}
{{- $cpReleaseName := $cp.releaseName | default "capsule" }}
{{- $cpChartVersion := $cp.chartVersion | default "0.12.4" }}

# ==============================================================================
# capsule-proxy component
# ==============================================================================
{{- $cpProxy := $cp.proxy | default dict }}
{{- $cpProxyEnabled := false }}
{{- if hasKey $cpProxy "enabled" }}
  {{- $cpProxyEnabled = $cpProxy.enabled }}
{{- end }}
{{- $cpProxyReleaseName := $cpProxy.releaseName | default "capsule-proxy" }}
{{- $cpProxyChartVersion := $cpProxy.chartVersion | default "0.10.0" }}
{{- $cpProxyUsernameClaim := $cpProxy.usernameClaim | default "preferred_username" }}
{{- $cpProxyReplicas := $cpProxy.replicas | default 1 }}

# ==============================================================================
# Auth integration (Zitadel OIDC App composition)
# ==============================================================================
{{- $auth := $spec.auth | default dict }}
{{- $authEnabled := false }}
{{- if hasKey $auth "enabled" }}
  {{- $authEnabled = $auth.enabled }}
{{- end }}
{{- $authIssuerURL := $auth.issuerURL | default "" }}
{{- $authProjectId := $auth.zitadelProjectId | default "" }}
{{- $authOidc := $auth.oidcClient | default dict }}
{{- $authOidc = dict
  "name" ($authOidc.name | default "capsule-proxy")
  "redirectUris" ($authOidc.redirectUris | default (list "http://localhost:8000" "http://localhost:18000"))
  "postLogoutRedirectUris" ($authOidc.postLogoutRedirectUris | default list)
}}

# ==============================================================================
# Initialize $state
# ==============================================================================
{{- $state := dict
  "name" $name
  "namespace" $namespace
  "clusterName" $clusterName
  "managementPolicies" $managementPolicies
  "labels" $labels
  "helmProviderConfigRef" $helmPCR
  "kubernetesProviderConfigRef" $k8sPCR
  "capsule" (dict
    "enabled" $cpEnabled
    "namespace" $cpNamespace
    "releaseName" $cpReleaseName
    "chartVersion" $cpChartVersion
    "values" ($cp.values | default dict)
    "overrideAllValues" ($cp.overrideAllValues | default dict)
    "proxy" (dict
      "enabled" $cpProxyEnabled
      "releaseName" $cpProxyReleaseName
      "chartVersion" $cpProxyChartVersion
      "usernameClaim" $cpProxyUsernameClaim
      "replicas" $cpProxyReplicas
      "values" ($cpProxy.values | default dict)
      "overrideAllValues" ($cpProxy.overrideAllValues | default dict)
    )
  )
  "auth" (dict
    "enabled" $authEnabled
    "issuerURL" $authIssuerURL
    "zitadelProjectId" $authProjectId
    "oidcClient" $authOidc
  )
  "observed" (dict)
  "status" (dict)
}}
